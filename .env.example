DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
ADMIN_TOKEN=change-me

# Optional — the /admin co-pilot chat proxies OpenRouter when this is set.
# Comma-separated model list; free models fall through in order.
OPENROUTER_API_KEY=

# Optional — canonical site URL for metadata/sitemap. Required in production,
# defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL=

# Optional, dev only — extra origins the dev server should accept, e.g. your
# LAN IP so you can test touch controls from a phone: 192.168.1.*
DEV_ORIGINS=
